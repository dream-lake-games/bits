{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "anim": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "file", "default"],
        "properties": {
          "name": { "type": "string" },
          "file": { "type": "string" },
          "default": { "type": "string" },
          "exclude": { "type": "string" },
          "fps": { "type": "integer" },
          "next": { "type": "object", "additionalProperties": { "type": "string" } },
          "variants": { "type": "object" }
        },
        "additionalProperties": false
      }
    }
  }
}


